# jarvis-osx-api — macOS personal-data bridge (port 7723)
# Native-only service: never runs in Docker (needs TCC grants + GUI session).
# Run: ./run.sh          (dev)
#      ./deploy-launchd.sh  (install as a LaunchAgent)
#
# Service URLs are resolved automatically from jarvis-config-service.
# Auth for this service's own endpoints is its locally-minted API keys
# (python cli.py generate-api-key ...), NOT jarvis-auth app creds.

# SERVER
OSX_API_PORT=7723
SERVER_HOST=0.0.0.0

# PATHS (defaults are right for a normal install; override for tests only)
# CHAT_DB_PATH=~/Library/Messages/chat.db
# OSX_API_DATA_DIR=~/.jarvis/osx-api

# CENTRALIZED LOGGING (app creds used ONLY to ship logs to jarvis-logs)
JARVIS_APP_ID=jarvis-osx-api
JARVIS_APP_KEY=CHANGE_ME_get_from_jarvis_auth_admin
JARVIS_LOG_CONSOLE_LEVEL=INFO
JARVIS_LOG_REMOTE_LEVEL=DEBUG
